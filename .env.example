# Copy to .env (or run `nncq init`). Process environment overrides this file. Empty = default.

# --- server
NNCQ_HOST=127.0.0.1          # non-loopback requires NNCQ_TOKEN
NNCQ_PORT=8765
NNCQ_TOKEN=                  # Bearer token clients must send (Authorization header)

# --- what to index
NNCQ_REPOS=                  # name=path;name2=path2   (alternative to `nncq index <path>`)
NNCQ_EXTRA_EXTENSIONS=       # .foo,.bar=cpp   (no =lang -> line-window chunks)
NNCQ_IGNORE=                 # extra gitignore-style patterns, comma-separated (.p4ignore is honoured)
NNCQ_TEXT_LANGS=markdown,cmake,make,dockerfile,proto,batch
NNCQ_DATA=true               # data<->code cross-reference (profiles with [[xref]] rules)
NNCQ_UML=true                # UML/SysML model at index time (members, relations, components, build configs);
                             # false: build it later on demand (nncq uml init / uml_build tool / dashboard button)
NNCQ_MAX_FILE_KB=1024
NNCQ_CHUNK_CHARS=3000
NNCQ_INDEX_PROCS=            # CPU processes for parsing (default: half the cores, max 8)

# --- keeping fresh
NNCQ_WATCH=true              # re-index on save while the server runs
NNCQ_WATCH_DEBOUNCE=5

# --- profile
NNCQ_MODE=full               # full = embeddings + reranker (NVIDIA GPU) | lite = keyword + graph + data xref, no GPU
                             # lite forces NNCQ_EMBED_TIER=0 and NNCQ_RERANK=false; the GPU settings below are ignored

# --- embeddings / GPU
NNCQ_EMBED_TIER=2            # 0 none (keywords + graph only), 1 card vectors, 2 cards then full chunks
NNCQ_EMBED_DIM=1024
NNCQ_DEVICE=auto             # auto | cuda | cpu
NNCQ_BG_WHEN=always          # always | idle (embed only after NNCQ_IDLE_MINUTES without input)
NNCQ_IDLE_MINUTES=5
NNCQ_GPU_MIN_FREE_MB=0       # don't start a batch when the GPU has less free VRAM
NNCQ_GPU_BATCH_TOKENS=32768
NNCQ_GPU_BREAK_EVERY_S=5     # background embedding pauses the GPU every N seconds...
NNCQ_GPU_BREAK_MS=100        # ...for this long, so screen capture / other GPU apps get in (0 = never)
NNCQ_GPU_RESERVE_MB=1024     # VRAM left for other apps: per-process cap = total - this; batches shrink when less is free
NNCQ_MODEL_IDLE_SECONDS=600  # unload query models from VRAM after this long unused
NNCQ_RERANK=true
NNCQ_RERANK_CANDIDATES=40
NNCQ_MAX_RESPONSE_KB=16        # larger tool answers are trimmed and paged with more(cursor); 0 = never
NNCQ_CACHE_MINUTES=15          # identical tool calls answered from memory until the index changes; 0 = off
