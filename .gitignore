.venv/
cache/
.env
__pycache__/
*.egg-info/
.pytest_cache/
# per-codebase profiles are private (repo names, paths, custom parsers); only the template is shared
profiles/*
!profiles/_template/
# the bundled demo's sample profile (examples/orbitkit), activated by `nncq init --profile _demo`
!profiles/_demo/
# in-repo git worktrees for parallel work
.worktrees/
# exported profile archives (nncq profile export): the folder is kept, its contents are private
archive/*
!archive/.gitkeep
